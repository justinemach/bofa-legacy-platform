{
  "extends": ["tslint:recommended"],
  "rulesDirectory": ["codelyzer"],
  "rules": {
    "component-selector": [true, "element", ["app", "bofa"], "kebab-case"],
    "directive-selector": [true, "attribute", ["app", "bofa"], "camelCase"],
    "no-any": false,
    "max-line-length": [true, 140],
    "quotemark": [true, "single"]
  }
}
