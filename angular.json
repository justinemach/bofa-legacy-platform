        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/bofa-core/tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "bofa-compliance": {
      "projectType": "library",
      "root": "projects/bofa-compliance",
      "sourceRoot": "projects/bofa-compliance/src",
      "prefix": "bofa",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
