      }
    },
    "digital-banking": {
      "projectType": "application",
      "root": "projects/digital-banking",
      "sourceRoot": "projects/digital-banking/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/digital-banking",
            "index": "projects/digital-banking/src/index.html",
            "main": "projects/digital-banking/src/main.ts",
            "polyfills": [
              "projects/digital-banking/src/polyfills.ts"
            ],
            "tsConfig": "projects/digital-banking/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [],
            "styles": [
              "projects/digital-banking/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 4200
          },
          "configurations": {
            "production": {
              "buildTarget": "digital-banking:build:production"
            },
            "development": {
              "buildTarget": "digital-banking:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "projects/digital-banking/src/polyfills.ts",
              "zone.js/testing"
            ],
            "tsConfig": "projects/digital-banking/tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "inlineStyleLanguage": "scss",
            "styles": [
              "projects/digital-banking/src/styles.scss"
            ],
            "scripts": [],
            "assets": []
          }
        }
      }
    },
